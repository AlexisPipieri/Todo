{
  "name": "menutodo",
  "version": "1.0.0",
  "description": "A minimal macOS menu bar todo app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:css": "node_modules/.bin/tailwindcss -i ./src/styles.css -o ./src/output.css",
    "watch:css": "node_modules/.bin/tailwindcss -i ./src/styles.css -o ./src/output.css --watch",
    "dev": "npm run build:css && electron .",
    "package": "npm run build:css && electron-builder --mac dir",
    "install-app": "npm run package && cp -r dist/mac-arm64/MenuTodo.app /Applications/MenuTodo.app"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.7.0",
    "tailwindcss": "^3.4.0"
  },
  "dependencies": {
    "uuid": "^9.0.0"
  },
  "build": {
    "appId": "com.alexispipieri.menutodo",
    "productName": "MenuTodo",
    "files": [
      "main.js",
      "src/**/*",
      "assets/**/*"
    ],
    "mac": {
      "target": {
        "target": "dir",
        "arch": ["arm64"]
      },
      "category": "public.app-category.productivity",
      "identity": null
    }
  }
}
