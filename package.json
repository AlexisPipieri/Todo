{
  "name": "menutodo",
  "version": "1.0.0",
  "description": "A minimal macOS menu bar todo app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:css": "tailwindcss -i ./src/styles.css -o ./src/output.css",
    "watch:css": "tailwindcss -i ./src/styles.css -o ./src/output.css --watch",
    "dev": "npm run build:css && electron ."
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "tailwindcss": "^3.4.0"
  },
  "dependencies": {
    "uuid": "^9.0.0"
  }
}
