{
  "name": "tdy",
  "version": "1.0.1",
  "description": "A minimal macOS menu bar todo app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:css": "node_modules/.bin/tailwindcss -i ./src/styles.css -o ./src/output.css",
    "watch:css": "node_modules/.bin/tailwindcss -i ./src/styles.css -o ./src/output.css --watch",
    "dev": "npm run build:css && electron .",
    "dev:seed": "npm run build:css && TDY_ENV=test electron .",
    "package": "npm run build:css && electron-builder --mac dir",
    "install-app": "npm run package && rm -rf /Applications/tdy.app && cp -r dist/mac-arm64/tdy.app /Applications/tdy.app && rm -rf dist",
    "dist": "npm run build:css && electron-builder --mac dmg"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.7.0",
    "tailwindcss": "^3.4.0"
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "electron-updater": "^6.8.3",
    "uuid": "^9.0.0"
  },
  "build": {
    "appId": "com.alexispipieri.tdy",
    "productName": "tdy",
    "files": [
      "main.js",
      "src/**/*",
      "assets/**/*",
      "node_modules/@phosphor-icons/web/src/regular/**"
    ],
    "dmg": {
      "artifactName": "tdy-arm64.dmg"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "notarize": true
    },
    "publish": {
      "provider": "github",
      "owner": "AlexisPipieri",
      "repo": "Todo"
    }
  }
}
